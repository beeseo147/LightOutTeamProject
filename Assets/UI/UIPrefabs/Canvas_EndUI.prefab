  m_FontData:
    m_Font: {fileID: 12800000, guid: af6e454bf9509b243969280723231c8e, type: 3}
    m_FontSize: 45
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 50
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uC2DC\uAC04\uC774 \uCD08\uACFC\uB410\uB2E4.\n\uB370\uC774\uBE44\uB4DC\uC640
    \uCF00\uBE48\uC740 \uBD88 \uAEBC\uC9C4 \uBC29\uC5D0 \uAC07\uD614\uB2E4.\n\n\uBC16\uC73C\uB85C
    \uB098\uAC00\uB294 \uAE38\uC740 \uC0AC\uB77C\uC84C\uB2E4.\n\uB0A8\uC740 \uAC74
    \uC7A0\uAE34 \uBB38\uACFC,\n\uAC00\uB054 \uB4E4\uB824\uC624\uB294 \uC11C\uB85C\uC758
    \uBAA9\uC18C\uB9AC\uBFD0\uC774\uC5C8\uB2E4."
