    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uB370\uC774\uBE44\uB4DC\uB294 \uD0C8\uCD9C\uC5D0 \uC131\uACF5\uD588\uB2E4.\n\uCF00\uBE48\uC740
    \uBD88 \uAEBC\uC9C4 \uBC29\uC5D0 \uB0A8\uACA8\uC84C\uB2E4.\n\n\uADF8 \uD6C4\uB85C
    \uADF8\uB294\n\uBE5B\uC744 \uBCF4\uC9C0 \uBABB\uD55C \uCC44\n\uC774\uB984 \uBAA8\uB97C
    \uD3D0\uAC00\uB97C \uB05D\uC5C6\uC774 \uD5E4\uB9F8\uB2E4.\n\n\uCD9C\uAD6C\uB3C4,
    \uAD6C\uC870\uB3C4 \uC5C6\uC5C8\uB2E4."
