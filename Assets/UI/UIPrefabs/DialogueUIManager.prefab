--- !u!114 &3921439926958809375
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9135297281730503977}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b12243362fb9224493ce7fda2bd9167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  audioSource: {fileID: 2076021805198192935}
  dialogueText: {fileID: 0}
  dialoguePanel: {fileID: 0}
  dialogueSegments:
  - startTime: 0
    endTime: 0
    speaker: ???
    dialogue: "\uC548\uB155. \uC798 \uC9C0\uB0C8\uC5B4?"
  - startTime: 0
    endTime: 3.328
    speaker: ???
    dialogue: "\uC548\uB155. \uC798 \uC9C0\uB0C8\uC5B4?"
  - startTime: 3.328
    endTime: 6.604
    speaker: ???
    dialogue: "\uCEA0\uD551\uB3C4 \uAC00\uACE0..."
  - startTime: 6.604
    endTime: 11.007
    speaker: ???
    dialogue: "\uADF8\uB3D9\uC548 \uCC38 \uC798 \uC0B4\uC558\uB098 \uBCF4\uB354\uB77C. "
  - startTime: 11.007
    endTime: 15.047
    speaker: ???
    dialogue: "\uB09C \uB9E4\uC77C\uC774 \uC9C0\uC625\uC774\uC5C8\uB294\uB370 \uB9D0\uC774\uC57C."
  - startTime: 15.047
    endTime: 17.105
    speaker: ???
    dialogue: "\uAE30\uC5B5\uC740 \uB098?"
  - startTime: 20.381
    endTime: 22.205
    speaker: ???
    dialogue: "\uADF8\uB798, \uBABB \uD560 \uC904 \uC54C\uC558\uC5B4."
  - startTime: 22.205
    endTime: 23.907
    speaker: ???
    dialogue: "\uC608\uC804\uC5D0 \uD559\uAD50 \uB2E4\uB2D0 \uB54C \uB9D0\uC774\uC57C."
  - startTime: 23.907
    endTime: 28.424
    speaker: ???
    dialogue: "\uB108\uD76C \uB458, \uADF8 \uB180\uC774\uB97C \uCC38 \uC88B\uC544\uD588\uC796\uC544.
      \uBB34\uC2A8 \uB180\uC774\uC600\uB354\uB77C?"
  - startTime: 28.424
    endTime: 30.74
    speaker: ???
    dialogue: "\uB9DE\uC544. \uB0A0 \uBCF4\uC77C\uB7EC\uC2E4\uC5D0 \uAC00\uB450\uB294
      \uAC70."
  - startTime: 30.74
    endTime: 32.021
    speaker: ???
    dialogue: "\uBD88\uC744 \uAEBC \uB193\uACE0,"
  - startTime: 32.021
    endTime: 34.983
    speaker: ???
    dialogue: "\uB0B4\uAC00 \uC18C\uB9AC\uB77C\uB3C4 \uC9C0\uB974\uB824 \uD558\uBA74
      \uB54C\uB838\uC9C0."
  - startTime: 34.983
    endTime: 38.44
    speaker: ???
    dialogue: "\uADF8\uB0A0 \uC774\uD6C4\uB85C \uB09C \uC9C0\uAE08\uB3C4 \uBD88\uC774
      \uAEBC\uC9C8 \uB54C\uB9C8\uB2E4 \uC228\uC774 \uB9C9\uD600."
  - startTime: 38.44
    endTime: 41.883
    speaker: ???
    dialogue: "\uB124\uAC00 \uC78A\uC5C8\uC744 \uAC70\uB780 \uAC74 \uC54C\uC544.
      \uAE30\uB300\uB3C4 \uC548 \uD588\uACE0."
  - startTime: 41.883
    endTime: 45.65
    speaker: ???
    dialogue: "\uADF8\uB0E5\u2026 \uB108\uB3C4 \uD55C \uBC88 \uB290\uAEF4\uBCF4\uBA74
      \uC88B\uC744 \uAC83 \uAC19\uC558\uC5B4."
  - startTime: 45.65
    endTime: 48.62
    speaker: ???
    dialogue: "\uC544\uBB34\uD2BC...\uBCF8\uB860\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC9C0."
  - startTime: 48.62
    endTime: 51.325
    speaker: ???
    dialogue: "\uBC29 \uC911\uC559\uC5D0 \uD4E8\uC988\uAC00 \uC788\uC5B4."
  - startTime: 51.325
    endTime: 58.815
    speaker: ???
    dialogue: "\uADF8\uAC78 \uB04A\uC73C\uBA74, \uBC18\uB300\uCABD \uBC29\uC774 \uC7A0\uAE30\uBA74\uC11C
      \uBD88\uC774 \uAEBC\uC9C0\uACE0, \uB124 \uBB38\uC740 \uC5F4\uB9B4 \uAC70\uC57C."
  - startTime: 56.363
    endTime: 58.429
    speaker: ???
    dialogue: "\uADF8\uB7FC \uB108\uB294 \uB4DC\uB514\uC5B4 \uB098\uAC08 \uC218 \uC788\uACA0\uC9C0. "
  - startTime: 58.815
    endTime: 61.084
    speaker: ???
    dialogue: "1\uBD84 \uC904\uAC8C."
  - startTime: 61.084
    endTime: 63.5
    speaker: ???
    dialogue: "\uC798 \uC0DD\uAC01\uD574 \uBD10."
  autoStart: 0
  loopDialogue: 0
  triggerKey: 283
  useFadeTransition: 1
  fadeSpeed: 0.1
