  m_EditorClassIdentifier: 
  audioSource: {fileID: 649414185056154528}
  dialogueText: {fileID: 0}
  dialoguePanel: {fileID: 0}
  dialogueSegments:
  - startTime: 0
    endTime: 0
    speaker: David
    dialogue: "\uADF8\uB550\u2026 \uB0B4\uAC00 \uBB58 \uD55C \uAC74\uC9C0\uB3C4 \uBAB0\uB790\uC5B4."
  - startTime: 0
    endTime: 2.408
    speaker: David
    dialogue: "\uADF8\uB550\u2026 \uB0B4\uAC00 \uBB58 \uD55C \uAC74\uC9C0\uB3C4 \uBAB0\uB790\uC5B4."
  - startTime: 3.42
    endTime: 7.288
    speaker: David
    dialogue: "\uC6B0\uB9AC\uAC00 \uD55C \uC9D3... \uBBF8\uC548\uD558\uB2E4."
  - startTime: 7.289
    endTime: 11.017
    speaker: David
    dialogue: "\uC544\uB9C8 \uC7A5\uB09C\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uC744
      \uC9C0\uB3C4 \uBAB0\uB77C, \uC9C0\uAE08\uC740 \uC544\uB2C8\uC9C0\uB9CC."
  - startTime: 11.692
    endTime: 15.979
    speaker: David
    dialogue: "\uB0B4\uAC00 \uBB34\uC2A8 \uB9D0\uC744 \uD574\uB3C4 \uADF8 \uC77C\uACFC
      \uB124 \uACE0\uD1B5\uC774 \uC5C6\uB358 \uC77C\uC774 \uB418\uC9C4 \uC54A\uACA0\uC9C0..."
  - startTime: 15.98
    endTime: 21.075
    speaker: David
    dialogue: "\uD558\uC9C0\uB9CC \uC815\uB9D0\uB85C \uD6C4\uD68C\uD574. \uC9C4\uC2EC\uC73C\uB85C."
  - startTime: 21.552
    endTime: 23.92
    speaker: David
    dialogue: "\uADF8\uAC83\uB9CC\uC740 \uB9D0\uD558\uACE0 \uC2F6\uC5C8\uC5B4."
  - startTime: 25.567
    endTime: 29.114
    speaker: David
    dialogue: "\uB124\uAC00 \uD558\uACE0 \uC2F6\uC740 \uB300\uB85C \uD574. \uC5EC\uAE30
      \uACC4\uC18D \uAC00\uB46C \uB450\uAC70\uB098."
  - startTime: 29.425
    endTime: 31.5
    speaker: David
    dialogue: "\uB09C \uADF8\uB798\uB3C4 \uC2FC \uB188\uC774\uB2C8\uAE4C..."
  autoStart: 0
  loopDialogue: 0
  triggerKey: 287
  useFadeTransition: 1
  fadeSpeed: 0.1
