  - startTime: 0
    endTime: 0
    speaker: David
    dialogue: "...\uBA38\uB9AC\uAC00 \uC9C0\uB048\uAC70\uB824. \uC5EC\uAE34 \uB300\uCCB4
      \uC5B4\uB514\uC57C?"
  - startTime: 0
    endTime: 3.046
    speaker: David
    dialogue: "...\uBA38\uB9AC\uAC00 \uC9C0\uB048\uAC70\uB824. \uC5EC\uAE34 \uB300\uCCB4
      \uC5B4\uB514\uC57C?"
  - startTime: 3.047
    endTime: 8.184
    speaker: Kevin
    dialogue: "\uBAB0\uB77C\u2026 \uADF8\uB0E5 \uC9D1 \uAC19\uAE34 \uD55C\uB370\u2026
      \uBC29\uAE08 \uBB34\uC2A8 \uC77C\uC774\uC5C8\uC9C0?"
  - startTime: 8.185
    endTime: 12.549
    speaker: David
    dialogue: "\uC6B4\uC804 \uC911\uC774\uC5C8\uC796\uC544. \uADF8\uB2E4\uC74C\uC740
      \uAE30\uC5B5 \uC548 \uB098."
  - startTime: 12.55
    endTime: 14.498
    speaker: Kevin
    dialogue: "\uC820\uC7A5, \uC81C\uB300\uB85C \uC5FF \uBA39\uC740 \uAC70 \uAC19\uC544."
  - startTime: 14.499
    endTime: 17.797
    speaker: David
    dialogue: "\uC77C\uB2E8 \uBB54\uAC00 \uB2E8\uC11C\uB97C \uCC3E\uC544\uBCF4\uC790.
      \uC5EC\uAE30\uC11C \uB098\uAC00\uC57C \uB3FC."
